// Prisma schema for the TokTickIT database.
// DATABASE_URL is read from server/.env, which is git-ignored; server/.env.example carries the shape of it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum ItPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  EDITED
  ASSIGNED
  STATUS_CHANGED
  COMPLETED
  CANCELLED
}

enum TicketWorkflowEventType {
  BASELINE
  CREATED
  STATUS_CHANGED
  OWNER_CHANGED
  PRIORITY_CHANGED
  REQUESTER_SIGNAL
  ACTION_CHANGED
}

model User {
  id                         Int             @id @default(autoincrement())
  email                      String          @unique @db.VarChar(254)
  displayName                String          @db.VarChar(100)
  role                       UserRole
  isActive                   Boolean         @default(true)
  mustChangePassword         Boolean         @default(true)
  version                    Int             @default(0)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @default(now()) @updatedAt
  credential                 Credential?
  sessions                   Session[]
  submittedTickets           Ticket[]        @relation("TicketSubmitter")
  ownedTickets               Ticket[]        @relation("TicketOwner")
  requesterResolutionTickets Ticket[]        @relation("RequesterResolutionActor")
  statusChangedTickets       Ticket[]        @relation("TicketStatusActor")
  ownerChangedTickets        Ticket[]        @relation("TicketOwnerActor")
  priorityChangedTickets     Ticket[]        @relation("TicketPriorityActor")
  uploadedAttachments        Attachment[]    @relation("AttachmentUploader")
  removedAttachments         Attachment[]    @relation("AttachmentRemover")
  publicComments             PublicComment[] @relation("PublicCommentAuthor")
  internalNotes              InternalNote[]  @relation("InternalNoteAuthor")
  createdActions             ActionTaken[]   @relation("ActionCreator")
  performedActions           ActionTaken[]   @relation("ActionPerformer")
  assignedActions            ActionTaken[]   @relation("ActionAssignee")
  completedActions           ActionTaken[]   @relation("ActionCompleter")
  cancelledActions           ActionTaken[]   @relation("ActionCanceller")
  actionEvents               ActionEvent[]   @relation("ActionEventActor")
  actionCreateRequests       ActionCreateRequest[]
  ticketWorkflowEvents       TicketWorkflowEvent[] @relation("WorkflowEventActor")

  @@index([isActive, displayName, id])
  @@index([role, isActive, displayName, id])
}

model Credential {
  userId            Int      @id
  passwordHash      String   @db.VarChar(255)
  createdAt         DateTime @default(now())
  passwordChangedAt DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  csrfToken  String    @db.Char(64)
  userId     Int
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]

  @@index([isActive, name])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]

  @@index([isActive, name])
}

model Ticket {
  id                          String            @id @default(uuid()) @db.Uuid
  ticketNumber                String            @unique @db.VarChar(19)
  submittedByUserId           Int
  categoryId                  Int
  relatedSystemId             Int
  ownerId                     Int?
  summary                     String            @db.VarChar(120)
  description                 String            @db.VarChar(2000)
  requestedPriority           RequestedPriority
  itPriority                  ItPriority
  currentStatus               TicketStatus      @default(NEW)
  requesterResolvedAt         DateTime?
  requesterResolvedByUserId   Int?
  lastStatusChangedAt         DateTime?
  lastStatusChangedByUserId   Int?
  lastOwnerChangedAt          DateTime?
  lastOwnerChangedByUserId    Int?
  lastPriorityChangedAt       DateTime?
  lastPriorityChangedByUserId Int?
  version                     Int               @default(0)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @default(now()) @updatedAt
  submittedBy                 User              @relation("TicketSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  owner                       User?             @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  requesterResolvedBy         User?             @relation("RequesterResolutionActor", fields: [requesterResolvedByUserId], references: [id], onDelete: Restrict)
  lastStatusChangedBy         User?             @relation("TicketStatusActor", fields: [lastStatusChangedByUserId], references: [id], onDelete: Restrict)
  lastOwnerChangedBy          User?             @relation("TicketOwnerActor", fields: [lastOwnerChangedByUserId], references: [id], onDelete: Restrict)
  lastPriorityChangedBy       User?             @relation("TicketPriorityActor", fields: [lastPriorityChangedByUserId], references: [id], onDelete: Restrict)
  category                    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem               RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments                 Attachment[]
  publicComments              PublicComment[]
  internalNotes               InternalNote[]
  actions                     ActionTaken[]
  actionCreateRequests        ActionCreateRequest[]
  workflowEvents              TicketWorkflowEvent[]

  @@index([submittedByUserId, updatedAt, id])
  @@index([submittedByUserId, createdAt, id])
  @@index([submittedByUserId, categoryId])
  @@index([submittedByUserId, relatedSystemId])
  @@index([submittedByUserId, currentStatus])
  @@index([submittedByUserId, requestedPriority])
  @@index([submittedByUserId, ticketNumber])
  @@index([updatedAt, id])
  @@index([createdAt, id])
  @@index([ownerId, updatedAt, id])
  @@index([currentStatus, updatedAt, id])
  @@index([itPriority, updatedAt, id])
  @@index([requestedPriority, updatedAt, id])
  @@index([categoryId, updatedAt, id])
  @@index([relatedSystemId, updatedAt, id])
  @@index([requesterResolvedByUserId])
  @@index([lastStatusChangedByUserId])
  @@index([lastOwnerChangedByUserId])
  @@index([lastPriorityChangedByUserId])
}

model Attachment {
  id               String    @id @default(uuid()) @db.Uuid
  ticketId         String    @db.Uuid
  originalName     String    @db.VarChar(255)
  storageName      String    @unique @db.VarChar(255)
  mimeType         String    @db.VarChar(100)
  sizeBytes        Int
  sha256           String    @db.Char(64)
  uploadedByUserId Int
  createdAt        DateTime  @default(now())
  removedAt        DateTime?
  removedByUserId  Int?
  removalReason    String?   @db.VarChar(250)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploadedBy       User      @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  removedBy        User?     @relation("AttachmentRemover", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
  @@index([uploadedByUserId])
  @@index([removedByUserId])
}

model PublicComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  Int
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation("PublicCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId])
}

model InternalNote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  Int
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId])
}

model ActionTaken {
  id                       String       @id @default(uuid()) @db.Uuid
  ticketId                 String       @db.Uuid
  actionAt                 DateTime     @db.Timestamptz(3)
  description              String       @db.VarChar(2000)
  result                   String       @default("") @db.VarChar(2000)
  status                   ActionStatus @default(PLANNED)
  createdByUserId          Int
  performedByUserId        Int
  assigneeId               Int?
  followUpRequired         Boolean      @default(false)
  followUpNote             String?      @db.VarChar(1000)
  attachmentNotes          String?      @db.VarChar(500)
  completedAt              DateTime?    @db.Timestamptz(3)
  completedByUserId        Int?
  completedTicketVersion   Int?
  cancelledAt              DateTime?    @db.Timestamptz(3)
  cancelledByUserId        Int?
  cancellationReason       String?      @db.VarChar(500)
  version                  Int          @default(0)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  ticket                   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy                User         @relation("ActionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  performedBy              User         @relation("ActionPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict)
  assignee                 User?        @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  completedBy              User?        @relation("ActionCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)
  cancelledBy              User?        @relation("ActionCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  events                   ActionEvent[]
  createRequests           ActionCreateRequest[]

  @@index([ticketId, actionAt, createdAt, id])
  @@index([assigneeId, status, actionAt])
  @@index([performedByUserId])
  @@index([status, completedTicketVersion])
}

model ActionEvent {
  id                     String          @id @default(uuid()) @db.Uuid
  actionId               String          @db.Uuid
  ticketId               String          @db.Uuid
  type                   ActionEventType
  actorId                Int
  occurredAt             DateTime        @default(now()) @db.Timestamptz(3)
  resultingActionVersion Int
  resultingTicketVersion Int
  changes                Json
  action                 ActionTaken     @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor                  User            @relation("ActionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actionId, occurredAt, id])
  @@index([ticketId, occurredAt, id])
}

model ActionCreateRequest {
  actorId         Int
  ticketId        String      @db.Uuid
  idempotencyKey  String      @db.Uuid
  requestHash     String      @db.Char(64)
  actionId        String      @db.Uuid
  response        Json
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  actor           User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ticket          Ticket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  action          ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@id([actorId, ticketId, idempotencyKey])
  @@index([actionId])
}

model TicketWorkflowEvent {
  id                     String                  @id @default(uuid()) @db.Uuid
  ticketId               String                  @db.Uuid
  type                   TicketWorkflowEventType
  actorId                Int?
  subjectActionId        String?                 @db.Uuid
  occurredAt             DateTime                @default(now()) @db.Timestamptz(3)
  resultingTicketVersion Int
  changes                Json
  ticket                 Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor                  User?                   @relation("WorkflowEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, occurredAt, id])
  @@index([ticketId, type, resultingTicketVersion])
}
